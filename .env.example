#######################################################################
# Karka AI & Tech Academy — environment template
#
# Copy to `.env.local` (git-ignored) and fill in. Every variable here is
# SERVER-ONLY: none is prefixed NEXT_PUBLIC_, so no value reaches the
# browser bundle. Never commit real keys.
#
# The site is fully functional with NONE of these set:
#   - the chatbot falls back to deterministic, grounded answers from the
#     local knowledge base (content/kb.json)
#   - lead forms still work provided the host filesystem is writable
#######################################################################

# ---------------------------------------------------------------------
# Karka Assistant — LLM provider (all optional)
# ---------------------------------------------------------------------

# Swappable providers: "gemini" (or "google"), "anthropic", or "openai".
# NOTE: any unrecognised value falls through to the OpenAI branch.
LLM_PROVIDER=gemini

# The single switch that enables LLM answers. If unset or empty, the chat
# route runs in deterministic knowledge-base mode and never calls out.
# Google Gemini keys: https://aistudio.google.com/
LLM_API_KEY=

# Specific model id (optional). When unset, the route tries a cascade of
# Gemini candidates and falls forward on 404/429/503:
#   gemini-3.8-flash -> gemini-3.5-flash-lite -> gemini-3-flash-preview
#   -> gemini-2.5-flash -> gemini-2.0-flash
# Setting this explicitly avoids wasted round trips.
LLM_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible base URL (optional, OpenAI provider only).
# Lets you point at Azure OpenAI, OpenRouter, or a local server.
# Defaults to https://api.openai.com/v1
LLM_BASE_URL=

# ---------------------------------------------------------------------
# Lead capture
# ---------------------------------------------------------------------

# REQUIRED ON SERVERLESS HOSTS (Vercel, Netlify, Cloudflare).
# /api/leads writes to data/leads.json, but serverless filesystems are
# read-only and ephemeral. Without a webhook the route correctly returns
# HTTP 503 with a WhatsApp fallback rather than faking success — so leads
# would be lost. Point this at Slack, Zapier, Make, a CRM, or a Google
# Apps Script endpoint.
LEADS_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Chat answer feedback (optional)
# ---------------------------------------------------------------------

# Where thumbs up/down ratings on assistant answers are forwarded.
# Payload is anonymous: { rating, messageId, answer, createdAt }. No IP,
# no cookie and no user-typed text is collected. Without this, ratings
# are written to the server log only.
CHAT_FEEDBACK_WEBHOOK_URL=
