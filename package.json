{
  "name": "karka-academy-redesign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-clean-next.mjs dev",
    "dev": "next dev",
    "dev:clean": "node scripts/ensure-clean-next.mjs force && next dev",
    "prebuild": "node scripts/ensure-clean-next.mjs prod",
    "build": "npm run build:kb && npm run build:assets && next build",
    "build:kb": "tsx scripts/build-kb.ts",
    "build:assets": "node scripts/generate-brand-assets.mjs",
    "test:chat": "tsx scripts/test-chatbot.ts",
    "test:scope": "node scripts/test-scope.mjs",
    "verify": "node scripts/verify-routes.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "check": "npm run build && npm run verify:all",
    "check:css": "node scripts/check-css.mjs",
    "images:audit": "node scripts/audit-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "ports": "node scripts/probe-ports.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
